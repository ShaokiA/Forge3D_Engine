# Simple Pyramid
# 4 base vertices + 1 top vertex

o Pyramid

v -1.5 0.0  1.5
v  1.5 0.0  1.5
v  1.5 0.0 -1.5
v -1.5 0.0 -1.5
v  0.0 2.5  0.0

vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vt 0.500000 1.000000

# Side faces
f 1/1 2/2 5/5
f 2/1 3/2 5/5
f 3/1 4/2 5/5
f 4/1 1/2 5/5

# Bottom face
f 1/1 4/2 3/3
f 1/1 3/3 2/4
